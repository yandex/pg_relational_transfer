{
  "source_rules": [
    {
      "table": "authors",
      "where": "author_id=1"
    }
  ],
  "traversal_rules": [
    {
      "type": "no_enter",
      "values": [
        {
          "table": "books",
          "where": "book_id=1"
        },
        {
          "table": "readers",
          "where": "reader_id=1"
        }
      ]
    }
  ]
}